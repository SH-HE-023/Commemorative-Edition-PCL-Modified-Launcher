<local:MyPageRight x:Class="PageLaunchRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:behaviors="clr-namespace:PCL.Controls.Behaviors"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <Border x:Name="PanAccountCard" Margin="0,0,0,15" CornerRadius="6" Background="#B4FFFFFF" BorderBrush="#6EFFFFFF" BorderThickness="1">
                <Grid>
                    <ContentControl x:Name="PanAccountHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="320" Height="330" Margin="10" />
                </Grid>
            </Border>
            <local:MyCard x:Name="PanNotice" Margin="0,0,0,15" Title="公告">
                <StackPanel Margin="18,34,18,14">
                    <TextBlock x:Name="LabNotice" Text="公告：本启动器是第三方基于 Plain Craft Launcher 2（PCL，作者 龙腾猫跃）二次修改的开源项目，与 PCL 官方无关，不代表原作者立场；源码托管于 GitHub，许可见仓库内 LICENCE。" FontSize="13" LineHeight="20" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray2}" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="PanWelcome" Margin="0,0,0,15">
                <StackPanel Margin="18,16,18,16">
                    <TextBlock Text="PCL CEPCLML 修改版" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}" />
                    <TextBlock Text="Minecraft Java 版启动器 · 离线皮肤" Margin="1,4,0,14" FontSize="13" Foreground="{StaticResource ColorBrushGray3}" />
                    <TextBlock Text="没有可用的游戏版本时，先下载一个；想和朋友联机，就到联机页开服或用组网；想让界面换成自己的照片，去设置里的个性化。"
                               FontSize="13" LineHeight="20" TextWrapping="Wrap" MaxWidth="520" Foreground="{StaticResource ColorBrushGray2}" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <local:MyButton x:Name="BtnWelcomeDownload" Text="下载游戏" Padding="15,8" Margin="0,0,10,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnWelcomeLink" Text="联机" Padding="15,8" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnWelcomeSkin" Text="个性化" Padding="15,8" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyHint x:Name="PanHint" RelativeSetup="HintSnapshot" Theme="Blue" CanClose="True" Margin="0,0,0,15"
                          Text="快照版 PCL CEPCLML 修改版 包含尚未正式发布的测试功能。&#xa;请不要随意发给其他人，或是用来制作整合包哦！" />
            <StackPanel x:Name="PanCustom">
            </StackPanel>
            <local:MyCard Margin="0,0,0,15" Title="启动日志" x:Name="PanLog">
                <local:MyTextBox x:Name="LabLog" Margin="15,34,15,13" Padding="0,4" IsReadOnly="True" IsUndoEnabled="False"
                         AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" HasBackground="False"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
